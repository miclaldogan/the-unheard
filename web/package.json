{
  "name": "unheard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "format:check": "prettier --check src/App.tsx src/api/narrative*.ts src/platform src/state/useNarrative.ts src/components/{Chamber,EchoCore,FieldCollection,FieldMission,NarrativeVoice,ProtectedDownload,RecordingFlow,experience}* src/styles.css"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
